{
  "name": "agentboard-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Agentboard Skills: show it once, any MCP agent can reuse it. Record a browser task once; agents replay it over MCP with no human clicks except approving risky steps, and a signed record.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentboard-mcp": "bin/agentboard-mcp.mjs"
  },
  "files": [
    "bin/agentboard-mcp.mjs",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "dev:api": "pnpm --filter @agentboard/api run dev",
    "dev:web": "pnpm --filter @agentboard/web run dev",
    "migrate": "pnpm --filter @agentboard/api run migrate",
    "scout": "tsx scripts/scout.ts",
    "bench:reuse": "tsx scripts/bench-reuse.ts",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://agentboard@127.0.0.1:54329/postgres} vitest run",
    "pg:start": "scripts/local-pg.sh start",
    "pg:stop": "scripts/local-pg.sh stop",
    "bundle:mcp": "pnpm --filter @agentboard/mcp exec tsup --config tsup.bundle.config.ts",
    "build:all": "pnpm -r --filter ./packages/* run build && pnpm --filter @agentboard/web run build",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "build:web:e2e": "VITE_API_URL=http://127.0.0.1:${E2E_API_PORT:-18787} VITE_EXECUTOR_URL=ws://127.0.0.1:9 pnpm --filter @agentboard/web exec vite build --outDir dist-e2e",
    "test:web": "pnpm build:web:e2e && playwright test",
    "verify": "scripts/verify.sh",
    "check:generated": "scripts/check-generated.sh",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "devDependencies": {
    "@agentboard/core": "workspace:*",
    "@agentboard/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
