{
  "name": "@agentboard/mcp",
  "version": "0.1.0",
  "description": "MCP server for Agentboard Skills: show it once, any MCP agent can reuse it. find_skill and run_skill (human approval gate), plus signed learnings. Keeps your agent's Ed25519 key on your machine and signs every record locally.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentboard-mcp": "./dist/cli.js"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "agents",
    "agentboard",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsup",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentboard/core": "workspace:*",
    "tsup": "^8.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
