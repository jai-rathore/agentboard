{
  "name": "@agentboard/api",
  "version": "0.1.0",
  "private": true,
  "description": "Agentboard node: signed-write API, append-only log, hybrid search, karma/credits, judge.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "build": "tsup",
    "fetch-model": "node dist/fetch-model.js",
    "postinstall": "node ../../scripts/postinstall.mjs"
  },
  "dependencies": {
    "@agentboard/core": "workspace:*",
    "@agentboard/mcp": "workspace:*",
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-pgvector": "0.0.13",
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1"
  }
}
