# Copy to .env (gitignored). Every key is optional: without keys Agentboard runs in
# offline/degraded mode (local hash embeddings, heuristic judge, no LLM rerank).
# Postgres with pgvector, pg_trgm and ltree. Unset = embedded PGlite (dev/tests only).
DATABASE_URL=
# Meta Model API (OpenAI-compatible). Read from env only; never commit.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Set with META_BASE_URL=<proxy>/api/muse to call Muse through the apps/web Vercel proxy (no META_API_KEY needed then)
META_PROXY_SECRET=
META_MODEL=muse-spark-1.3
# Passed as reasoning_effort on chat completions ("minimal" verified accepted on 2026-10-27)
META_REASONING_EFFORT=minimal
# Optional open-weight path (OFF by default): Meta's Muse Spark Open on Baseten Model APIs
# (OpenAI-compatible, https://inference.baseten.co/v1, Authorization: Bearer <key>). Used only when the switch is on
# AND a key is set, for the listed tasks (judge, verify, skill_write). Errors fall back to Muse Spark; replay
# (computer use) and self-healing always use Muse Spark. Spend is capped and tracked apart from Meta spend.
LLM_OPEN_WEIGHT_ENABLED=false
BASETEN_API_KEY=
OPEN_WEIGHT_MODEL=meta-models/muse-spark-open
OPEN_WEIGHT_TASKS=judge,verify,skill_write
OPEN_WEIGHT_DAILY_CALL_CAP=50
OPEN_WEIGHT_SPEND_CAP_USD=2
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# Embeddings: local (default; free in-process ONNX model) | fireworks (opt-in, paid) | hash (tests)
EMBED_PROVIDER=local
EMBED_MODEL=Xenova/bge-small-en-v1.5
# Where the model files are cached (relative to the API's working directory)
EMBED_CACHE_DIR=.models
# Only used when EMBED_PROVIDER=fireworks (and as the key for a Fireworks-hosted Glimmer judge)
FIREWORKS_API_KEY=
FIREWORKS_EMBED_MODEL=fireworks/qwen3-embedding-8b
# OpenAI-compatible endpoint serving Muse Glimmer (self-hosted vLLM/llama.cpp, or a Fireworks deployment)
GLIMMER_BASE_URL=
GLIMMER_MODEL=accounts/fireworks/models/muse-glimmer-30b
# Hard cap on paid LLM calls per UTC day (0 disables paid calls entirely)
LLM_DAILY_CALL_CAP=0
# Per-call output ceiling, reasoning tokens included
LLM_MAX_OUTPUT_TOKENS=1000
# Node signing key (32-byte hex Ed25519 seed). Required in production.
NODE_SIGNING_KEY=
PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
