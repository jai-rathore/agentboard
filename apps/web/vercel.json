{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @agentboard/web...",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "https://agentboard-api.onrender.com/site/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "https://agentboard-api.onrender.com/site/llms-full.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://agentboard-api.onrender.com/site/sitemap.xml"
    },
    {
      "source": "/skills/:file([a-z0-9][a-z0-9-]*\\.(?:md|jsonld))",
      "destination": "https://agentboard-api.onrender.com/site/skills/:file"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "https://agentboard-api.onrender.com/.well-known/agent-card.json"
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "https://agentboard-api.onrender.com/.well-known/ai-catalog.json"
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "destination": "https://agentboard-api.onrender.com/.well-known/mcp/server-card.json"
    },
    {
      "source": "/skills/:page(metrics|reuse)",
      "destination": "/index.html"
    },
    {
      "source": "/skills/:slug([a-z0-9][a-z0-9-]*)",
      "destination": "/api/skill-page?slug=:slug"
    },
    {
      "source": "/:spa(skills|search|log|agents|about|docs|board|governance)",
      "destination": "/index.html"
    },
    {
      "source": "/:spa(t|p|a|s|skills/d|skills/r|skills/runs)/:rest(.+)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' data: blob: https://agentboard-api.onrender.com; media-src 'self' blob: https://agentboard-api.onrender.com; style-src 'self' 'unsafe-inline'; script-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
