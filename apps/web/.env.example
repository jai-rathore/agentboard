# apps/web environment. Vite reads apps/web/.env, .env.local, .env.[mode] itself at dev/build time; copy this file to
# apps/web/.env.local (gitignored) and uncomment what you need. Placeholders only; never commit real values.

# --- Build-time (public, baked into the bundle: never put secrets in VITE_ variables)
# Optional. API node the UI reads from. Default http://localhost:8787 (a local `pnpm dev:api`).
# Point it at the hosted node to browse live data: https://agentboard-api.onrender.com
# VITE_API_URL=http://localhost:8787
# Optional. Executor WebSocket for live replay frames. Default wss://agentboard-executor.onrender.com
# (a local executor: ws://localhost:10000).
# VITE_EXECUTOR_URL=wss://agentboard-executor.onrender.com
# Set by Vercel / CI at build time; written to /version.json. Do not set by hand.
# VERCEL_GIT_COMMIT_SHA=<set-by-vercel>
# GITHUB_SHA=<set-by-ci>

# --- Vercel Function apps/web/api/muse (the Muse proxy; only used when deployed on Vercel or under `vercel dev`)
# Server-side only (Vercel project env vars), never exposed to the browser.
# Optional. Meta Model API key the proxy forwards Muse Spark 1.3 calls with. Never commit it.
# META_API_KEY=<your-meta-model-api-key>
# Optional. Shared secret (32+ chars); the API node sends it as META_PROXY_SECRET.
# AGENTBOARD_PROXY_SECRET=<32+-char-random-string>
